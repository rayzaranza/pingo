{
  "name": "pingo-ui",
  "private": false,
  "description": "A UI library made with React that provide design tokens, components and icons.",
  "version": "0.0.3",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/pingo.js",
      "types": "./dist/pingo.d.ts"
    },
    "./styles.css": "./dist/pingo.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006  --no-open --disable-telemetry",
    "generate-tokens": "tsx watch --include './src/styles/tokens/*' ./scripts/generate-tokens.ts",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "classnames": "^2.5.1",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@types/babel__core": "^7.20.5",
    "@types/flat": "^5.0.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.4.1",
    "flat": "^6.0.1",
    "globals": "^17.5.0",
    "playwright": "^1.59.1",
    "storybook": "^10.4.1",
    "svgo": "^4.0.1",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "unplugin-dts": "^1.0.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "imports": {
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx",
      "./*.js",
      "./*.jsx"
    ]
  },
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f"
}
