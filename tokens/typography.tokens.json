{
  "font": {
    "size": {
      "100": {
        "$type": "number",
        "$value": 14,
        "$description": "Smallest text size. Used for captions and helper text.",
        "$extensions": {
          "com.figma.variableId": "VariableID:13:127",
          "com.figma.scopes": [
            "FONT_SIZE"
          ]
        }
      },
      "200": {
        "$type": "number",
        "$value": 16,
        "$description": "Base text size. Used for body copy and default UI text.",
        "$extensions": {
          "com.figma.variableId": "VariableID:13:128",
          "com.figma.scopes": [
            "FONT_SIZE"
          ]
        }
      },
      "300": {
        "$type": "number",
        "$value": 20,
        "$description": "Medium text size. Used for subheadings and prominent labels.",
        "$extensions": {
          "com.figma.variableId": "VariableID:13:129",
          "com.figma.scopes": [
            "FONT_SIZE"
          ]
        }
      },
      "400": {
        "$type": "number",
        "$value": 24,
        "$description": "Large text size. Used for section headings.",
        "$extensions": {
          "com.figma.variableId": "VariableID:13:130",
          "com.figma.scopes": [
            "FONT_SIZE"
          ]
        }
      },
      "500": {
        "$type": "number",
        "$value": 32,
        "$description": "Extra large text size. Used for page-level headings.",
        "$extensions": {
          "com.figma.variableId": "VariableID:13:131",
          "com.figma.scopes": [
            "FONT_SIZE"
          ]
        }
      }
    },
    "weight": {
      "regular": {
        "$type": "number",
        "$value": 400,
        "$description": "Regular weight. Used for body text and most UI labels.",
        "$extensions": {
          "com.figma.variableId": "VariableID:13:143",
          "com.figma.scopes": [
            "FONT_STYLE"
          ]
        }
      },
      "bold": {
        "$type": "number",
        "$value": 700,
        "$description": "Bold weight. Used for emphasis and headings.",
        "$extensions": {
          "com.figma.variableId": "VariableID:13:144",
          "com.figma.scopes": [
            "FONT_STYLE"
          ]
        }
      }
    },
    "family": {
      "default": {
        "$type": "string",
        "$value": "Outfit, sans-serif",
        "$description": "Primary sans-serif font. Used across all UI components.",
        "$extensions": {
          "com.figma.variableId": "VariableID:13:132",
          "com.figma.scopes": [
            "FONT_FAMILY"
          ],
          "com.figma.type": "string"
        }
      },
      "code": {
        "$type": "string",
        "$value": "Fira Code, monospace",
        "$description": "Monospace font. Used for code snippets and technical content.",
        "$extensions": {
          "com.figma.variableId": "VariableID:114:4250",
          "com.figma.scopes": [
            "FONT_FAMILY"
          ],
          "com.figma.type": "string"
        }
      }
    }
  },
  "$extensions": {
    "com.figma.modeName": "typography"
  }
}